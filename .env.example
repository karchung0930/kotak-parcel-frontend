# Where the Laravel backend repository is checked out, relative to this folder.
KOTAK_BACKEND_PATH=../kotak-parcel-backend

VITE_APP_NAME=Kotak

# Live delivery progress: where browsers reach Laravel Reverb. The build
# puts these in the pages, so build again after changing them. The key is
# the backend's REVERB_APP_KEY. Locally Reverb listens on port 8080 (the
# backend's composer run dev starts it); on a server, nginx passes /app on
# to Reverb behind the site's own address and port 443 with https. Without a
# key, the track and order pages show the stops as they were when opened.
VITE_REVERB_APP_KEY=kotak-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
